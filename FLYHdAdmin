-----------------------------------------------------------
-- SISTEMA DE ARRASTAR SUAVE (TWEEN)
-----------------------------------------------------------

local function applySoftDrag(frame)
    local dragging = false
    local dragInput, dragStart, startPos
    local tweenSpeed = 0.15 

    frame.Active = true
    frame.Selectable = true

    local function update(input)
        if not dragging then return end
        local delta = input.Position - dragStart
        local newPos = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
        TweenService:Create(frame, TweenInfo.new(tweenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = newPos
        }):Play()
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

applySoftDrag(LMG2L["Frame_2"])

-----------------------------------------------------------
-- ADVANCED FLIGHT SYSTEM (ENGINE)
-----------------------------------------------------------

local function getCharacter() return player.Character or player.CharacterAdded:Wait() end
local function getRootPart() return getCharacter():FindFirstChild("HumanoidRootPart") end

local function enableNoclip()
    local char = getCharacter()
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local function waitForControlModule()
    local playerModule = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
    return require(playerModule):GetControls()
end

local function getInputVector(controlModule)
    if controlModule then
        local success, controlVector = pcall(function() return controlModule:GetMoveVector() end)
        if success and controlVector and controlVector.Magnitude > 0.05 then
            return controlVector
        end
    end
    local humanoid = getCharacter():FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
        return humanoid.MoveDirection
    end
    return Vector3.new(0, 0, 0)
end

local function stopFly()
    flying = false
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    local hum = getCharacter():FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    
    -- Restaurar colisão
    local char = getCharacter()
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.CanCollide = true
        end
    end
end

local function startFly()
    local root = getRootPart()
    if not root then return end
    stopFly()
    flying = true

    bodyVelocity = Instance.new("BodyVelocity", root)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    bodyGyro = Instance.new("BodyGyro", root)
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.P = 5000
    bodyGyro.D = 500

    local hum = getCharacter():FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end

    local controlModule = waitForControlModule()
    local camera = workspace.CurrentCamera
    lastLookDirection = camera.CFrame.LookVector

    flyConnection = RunService.Heartbeat:Connect(function(dt)
        if not flyEnabled or not flying then return end
        
        local moveVec = getInputVector(controlModule)
        local targetVelocity = Vector3.zero
        
        -- Movimento baseado na câmera
        if moveVec.Magnitude > 0 then
            local cameraCFrame = camera.CFrame
            local worldMoveVector = cameraCFrame:VectorToWorldSpace(moveVec)
            targetVelocity = worldMoveVector.Unit * flySpeed
        end

        -- Subir/Descer
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            targetVelocity = targetVelocity + Vector3.new(0, flySpeed, 0)
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            targetVelocity = targetVelocity + Vector3.new(0, -flySpeed, 0)
        end

        -- Aplicação suave
        bodyVelocity.Velocity = bodyVelocity.Velocity:Lerp(targetVelocity, math.clamp(dt * acceleration, 0, 1))
        
        -- Rotação e Inclinação (Tilt)
        local currentLook = camera.CFrame.LookVector
        local smoothedLook = lastLookDirection:Lerp(currentLook, math.clamp(dt * rotationSmoothness, 0, 1))
        lastLookDirection = smoothedLook
        
        local targetCFrame = CFrame.lookAt(root.Position, root.Position + smoothedLook)
        
        -- Efeito de inclinação ao mover
        if bodyVelocity.Velocity.Magnitude > 5 then
            local moveDir = bodyVelocity.Velocity.Unit
            local cameraLook = camera.CFrame.LookVector
            local forwardAmount = moveDir:Dot(cameraLook)
            local pitch = math.clamp(-forwardAmount * 0.5, -0.7, 0.7)
            targetCFrame = targetCFrame * CFrame.Angles(pitch, 0, 0)
        end

        bodyGyro.CFrame = bodyGyro.CFrame:Lerp(targetCFrame, math.clamp(dt * rotationSmoothness, 0, 1))
        enableNoclip()
    end)
end

