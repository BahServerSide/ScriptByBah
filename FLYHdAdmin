    )

    -- Posição de saída: fora da tela pela direita  
    local exitPosition = UDim2.new(1, 50, 1, -110)  
    
    -- Criar e iniciar a animação de saída  
    local tween = TweenService:Create(G2L["Frame_2"], tweenInfo, {Position = exitPosition})  
